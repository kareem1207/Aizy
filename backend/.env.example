# --- Server ---
PORT=5000
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# --- Data ---
# "memory" runs with no databases (data resets on restart). "db" uses MongoDB + MySQL below.
DATA_MODE=db
MONGO_URL=mongodb://localhost:27017/aizy
SQL_DATABASE_URL=mysql://user:password@localhost:3306/aizy

# --- Auth ---
# Required in production. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Creates the first admin account on startup if it does not exist (min 8 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email (sign-up verification codes) ---
# Without a key the API returns the code in the response, in non-production only.
RESEND_API_KEY=
MAIL_FROM=Aizy <onboarding@resend.dev>
